# ── Firebase Admin (서버) ─────────────────────────────────────────────────────
# 서비스 계정 키 파일 경로 (secrets/ 폴더에 넣고 .gitignore로 보호)
FIREBASE_SERVICE_ACCOUNT_JSON=secrets/firebase_service_account.json

# 세션 쿠키 서명 비밀키 (충분히 길고 랜덤하게 설정)
SESSION_SECRET=draw2trade_super_secret_key

# ── Firebase 클라이언트 (공개 설정 — 노출해도 안전) ───────────────────────────
# Firebase 콘솔 → 프로젝트 설정 → 내 앱 → 웹 앱 구성에서 복사
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ── 한국투자증권 (KIS) Open API ───────────────────────────────────────────────
# https://apiportal.koreainvestment.com 에서 발급
# 설정 시 KR/US 주가 데이터를 KIS API로 수신 (미설정 시 pykrx/yfinance fallback)
KIS_APP_KEY=
KIS_APP_SECRET=
# KIS_MODE: real (실전투자) | mock (모의투자) — 기본값 real
KIS_MODE=real

# ── Anthropic Claude API (사용 중단 — Gemini 단일화됨) ──────────────────────
# 이 변수는 더 이상 사용되지 않습니다. 설정돼 있어도 무시됩니다.
# 모든 AI 기능은 GEMINI_API_KEY 하나로 통합되었습니다.
# ANTHROPIC_API_KEY=

# ── Sentry 에러 모니터링 (운영 환경 권장) ────────────────────────────────────
# https://sentry.io 에서 프로젝트 생성 후 DSN 발급
# 미설정 시 에러가 stdout 로그로만 나감 (Sentry 미활성)
SENTRY_DSN=
# 환경 구분용 (선택) — production / staging / dev
ENV=production
# 배포 버전 (선택, release health 추적용) — 예: v1.0.0
RELEASE_VERSION=
# 성능 트레이싱 샘플링 비율 (0.0~1.0). 기본 0.05 (5%)
SENTRY_TRACES_SAMPLE_RATE=0.05

# ── Kakao SDK (공유하기, 카카오톡 로그인 확장 대비) ──────────────────────────
# https://developers.kakao.com → 앱 → 앱 키 → JavaScript 키
# 프론트엔드 JS 에서만 사용하는 공개 키 (서버 비밀 키 아님)
# 미설정 시 카카오 공유 버튼이 숨겨짐
KAKAO_JS_APP_KEY=

# 서비스 공개 도메인 (카카오 공유 시 링크 베이스 URL 로 사용)
# 예: https://draw2trade.com
# 미설정 시 request.url 의 base 를 사용
PUBLIC_BASE_URL=

# ── Google Gemini API (AI 차트 이미지 추출 — Pro 전용) ──────────────────────
# https://aistudio.google.com/apikey 에서 발급 (무료 티어 있음)
# 용도: 사용자가 HTS/MTS 캡처 이미지 업로드 → 종가 선을 0~1 정규화 좌표로 변환
# 사용 모델: gemini-2.5-flash (이미지 1장당 약 $0.002)
# 미설정 시 /api/ai/extract_from_image 가 500 에러 대신 graceful fallback 반환
GEMINI_API_KEY=

# ── 금융감독원 Open DART API ──────────────────────────────────────────────────
# https://opendart.fss.or.kr 에서 발급 (무료)
# 미설정 시 DART 관련 엔드포인트(/api/v1/dart/*)가 503을 반환
DART_API_KEY=
