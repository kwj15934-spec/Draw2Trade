# ── Firebase Admin (서버) ─────────────────────────────────────────────────────
# 서비스 계정 키 파일 경로 (secrets/ 폴더에 넣고 .gitignore로 보호)
FIREBASE_SERVICE_ACCOUNT_JSON=secrets/firebase_service_account.json

# 세션 쿠키 서명 비밀키 (충분히 길고 랜덤하게 설정)
SESSION_SECRET=draw2trade_super_secret_key

# ── Firebase 클라이언트 (공개 설정 — 노출해도 안전) ───────────────────────────
# Firebase 콘솔 → 프로젝트 설정 → 내 앱 → 웹 앱 구성에서 복사
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# ── 한국투자증권 (KIS) Open API ───────────────────────────────────────────────
# https://apiportal.koreainvestment.com 에서 발급
# 설정 시 KR/US 주가 데이터를 KIS API로 수신 (미설정 시 pykrx/yfinance fallback)
KIS_APP_KEY=
KIS_APP_SECRET=
# KIS_MODE: real (실전투자) | mock (모의투자) — 기본값 real
KIS_MODE=real

# ── Sentry 에러 모니터링 (운영 환경 권장) ────────────────────────────────────
# https://sentry.io 에서 프로젝트 생성 후 DSN 발급
# 미설정 시 에러가 stdout 로그로만 나감 (Sentry 미활성)
SENTRY_DSN=
# 환경 구분용 (선택) — production / staging / dev
ENV=production
# 배포 버전 (선택, release health 추적용) — 예: v1.0.0
RELEASE_VERSION=
# 성능 트레이싱 샘플링 비율 (0.0~1.0). 기본 0.05 (5%)
SENTRY_TRACES_SAMPLE_RATE=0.05

# ── Kakao SDK (공유하기, 카카오톡 로그인 확장 대비) ──────────────────────────
# https://developers.kakao.com → 앱 → 앱 키 → JavaScript 키
# 프론트엔드 JS 에서만 사용하는 공개 키 (서버 비밀 키 아님)
# 미설정 시 카카오 공유 버튼이 숨겨짐
KAKAO_JS_APP_KEY=

# 서비스 공개 도메인 (카카오 공유 시 링크 베이스 URL 로 사용)
# 예: https://draw2trade.com
# 미설정 시 request.url 의 base 를 사용
PUBLIC_BASE_URL=

# ── 금융감독원 Open DART API ──────────────────────────────────────────────────
# https://opendart.fss.or.kr 에서 발급 (무료)
# 미설정 시 DART 관련 엔드포인트(/api/v1/dart/*)가 503을 반환
DART_API_KEY=

# ── Google Gemini API (재무 Q&A 자연어 답변) ─────────────────────────────────
# https://aistudio.google.com/apikey 에서 발급 (무료 티어 있음)
# 미설정 시 /api/v1/fundamental/{symbol}/qa 엔드포인트가 503을 반환
# (개요 탭의 "재무 Q&A" 카드만 영향, 나머지 재무 기능은 정상 동작)
GEMINI_API_KEY=

# ── 금융결제원 오픈뱅킹 (입금 자동확인 + 환불 계좌검증) ──────────────────────
# https://developers.openbanking.or.kr 이용기관 등록 후 발급
# OPENBANKING_MODE: testbed (테스트) | production (운영)
OPENBANKING_MODE=testbed
OPENBANKING_CLIENT_ID=
OPENBANKING_CLIENT_SECRET=
# 이용기관코드 (client_id 발급 시 같이 옴)
OPENBANKING_USE_CODE=
# ── 약정계좌 (둘 중 하나만 있어도 동작) ──────────────────────────────────────
# 방식 A (권장): 계좌번호 직접 사용 (이용기관 자체계좌, Center 인증)
#   - bank_code_std + account_num 만 있으면 즉시 동작
#   - 별도 핀테크이용번호 발급 불필요
OPENBANKING_BANK_CODE_STD=020              # 020 = 우리은행
OPENBANKING_ACCOUNT_NUM=1005004889621
OPENBANKING_ACCOUNT_HOLDER=김원준

# 방식 B (선택): 핀테크이용번호 (24자리) — 별도 등록 후 발급된 경우만
#   - 미설정이면 방식 A로 동작
OPENBANKING_FINTECH_USE_NUM=
# 입금 자동확인 폴링 주기 (초). 0 또는 미설정 시 워커 비활성화
OPENBANKING_POLL_INTERVAL_SEC=120

# 자동 매칭 활성 플래그 — false 면 사용자에게 "수동 처리" 안내, 폴러도 비활성
# 약정계좌 승인 대기 중에는 false, 승인 완료 후 true 로 전환 (서버 재시작 필요)
BANK_TRANSFER_AUTO_MATCH=false

# ── PayPal Subscriptions (legacy — 계좌이체 전환으로 미사용) ────────────────
# https://developer.paypal.com → My Apps & Credentials → 앱 생성
# PAYPAL_MODE: sandbox (테스트) | live (운영)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID — 대시보드 → App → Webhooks 등록 후 발급되는 ID
# (수신 URL: https://draw2trade.com/api/payment/webhook)
PAYPAL_WEBHOOK_ID=
# Plan ID (1회 — scripts/create_paypal_plans.py 실행 후 발급되는 값 입력)
# 월 $6 / 연 $60, 외부 세금 10%
PAYPAL_PLAN_ID_MONTHLY=
PAYPAL_PLAN_ID_ANNUAL=
